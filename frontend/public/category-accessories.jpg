<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 250">
  <!-- Accessories Background -->
  <defs>
    <linearGradient id="accGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#636363;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#a0a0a0;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="url(#accGrad)"/>
  
  <!-- Headphones illustration -->
  <g transform="translate(80, 40)">
    <!-- Left ear -->
    <circle cx="30" cy="20" r="18" fill="#c0c0c0" stroke="#888" stroke-width="2"/>
    <circle cx="30" cy="20" r="12" fill="#e8e8e8"/>
    <!-- Band -->
    <path d="M 30 5 Q 70 0 70 5" stroke="#888" stroke-width="6" fill="none" stroke-linecap="round"/>
    <!-- Right ear -->
    <circle cx="110" cy="20" r="18" fill="#c0c0c0" stroke="#888" stroke-width="2"/>
    <circle cx="110" cy="20" r="12" fill="#e8e8e8"/>
  </g>
  
  <!-- Wireless earpods illustration -->
  <g transform="translate(160, 80)">
    <!-- Left pod -->
    <ellipse cx="25" cy="30" rx="10" ry="18" fill="#222"/>
    <ellipse cx="25" cy="30" rx="6" ry="12" fill="#555"/>
    <!-- Right pod -->
    <ellipse cx="55" cy="30" rx="10" ry="18" fill="#222"/>
    <ellipse cx="55" cy="30" rx="6" ry="12" fill="#555"/>
    <!-- Case -->
    <rect x="15" y="52" width="50" height="30" rx="4" fill="#333" stroke="#666" stroke-width="2"/>
    <line x1="35" y1="52" x2="35" y2="82" stroke="#555" stroke-width="1"/>
  </g>
  
  <!-- Text -->
  <text x="200" y="200" font-size="32" font-weight="bold" fill="white" text-anchor="middle">Accessories</text>
  <text x="200" y="230" font-size="16" fill="rgba(255,255,255,0.8)" text-anchor="middle">Shop Now →</text>
</svg>
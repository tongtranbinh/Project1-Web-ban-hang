<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 250">
  <!-- Audio Background -->
  <defs>
    <linearGradient id="audioGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2c3e50;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a252f;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="url(#audioGrad)"/>
  
  <!-- Wireless earbuds illustration -->
  <g transform="translate(100, 50)">
    <!-- Left earbud -->
    <ellipse cx="40" cy="40" rx="16" ry="28" fill="#1a1a1a" stroke="#444" stroke-width="2"/>
    <ellipse cx="40" cy="35" rx="10" ry="18" fill="#333"/>
    <circle cx="40" cy="32" r="6" fill="#666"/>
    
    <!-- Right earbud -->
    <ellipse cx="120" cy="40" rx="16" ry="28" fill="#1a1a1a" stroke="#444" stroke-width="2"/>
    <ellipse cx="120" cy="35" rx="10" ry="18" fill="#333"/>
    <circle cx="120" cy="32" r="6" fill="#666"/>
    
    <!-- Charging case -->
    <rect x="65" y="75" width="50" height="35" rx="5" fill="#222" stroke="#555" stroke-width="2"/>
    <rect x="68" y="78" width="44" height="29" rx="3" fill="#111"/>
    <circle cx="90" cy="92.5" r="3" fill="#4a4a4a"/>
  </g>
  
  <!-- Sound waves -->
  <g transform="translate(200, 70)" stroke="#4a9eff" stroke-width="2" fill="none">
    <path d="M 0 0 Q 8 -8 16 0" opacity="0.8"/>
    <path d="M 5 0 Q 13 -12 21 0" opacity="0.6"/>
    <path d="M 10 0 Q 18 -16 26 0" opacity="0.4"/>
  </g>
  
  <!-- Text -->
  <text x="200" y="200" font-size="32" font-weight="bold" fill="white" text-anchor="middle">Audio</text>
  <text x="200" y="230" font-size="16" fill="rgba(255,255,255,0.8)" text-anchor="middle">Shop Now →</text>
</svg>
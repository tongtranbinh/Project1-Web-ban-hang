<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 250">
  <!-- Laptop Background -->
  <defs>
    <linearGradient id="laptopGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="url(#laptopGrad)"/>
  
  <!-- Laptop illustration -->
  <g transform="translate(100, 50)">
    <!-- Laptop screen -->
    <rect x="20" y="10" width="160" height="100" rx="5" fill="#1a1a2e" stroke="#fff" stroke-width="3"/>
    <!-- Screen content (graphs) -->
    <rect x="30" y="20" width="30" height="50" fill="#ff6b6b"/>
    <rect x="70" y="30" width="30" height="40" fill="#ffd93d"/>
    <rect x="110" y="15" width="30" height="55" fill="#6bcf7f"/>
    <rect x="150" y="35" width="20" height="35" fill="#4d96ff"/>
    <!-- Keyboard -->
    <rect x="15" y="115" width="170" height="15" rx="3" fill="#333" stroke="#999" stroke-width="1"/>
    <line x1="20" y1="117" x2="175" y2="117" stroke="#555" stroke-width="1"/>
  </g>
  
  <!-- Text -->
  <text x="200" y="200" font-size="32" font-weight="bold" fill="white" text-anchor="middle">Laptops</text>
  <text x="200" y="230" font-size="16" fill="rgba(255,255,255,0.8)" text-anchor="middle">Shop Now →</text>
</svg>
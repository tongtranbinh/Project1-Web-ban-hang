<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 250">
  <!-- Smartphone Background -->
  <defs>
    <linearGradient id="phoneGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e3c72;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2a5298;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="url(#phoneGrad)"/>
  
  <!-- Smartphone illustration -->
  <g transform="translate(140, 40)">
    <!-- Phone body -->
    <rect x="10" y="0" width="80" height="140" rx="8" fill="#000" stroke="#333" stroke-width="2"/>
    <!-- Screen -->
    <rect x="15" y="10" width="70" height="110" rx="4" fill="#1a1a2e"/>
    <!-- Screen content (light rays) -->
    <circle cx="35" cy="30" r="15" fill="#ff9ff3" opacity="0.8"/>
    <circle cx="55" cy="25" r="12" fill="#54a0ff" opacity="0.8"/>
    <circle cx="45" cy="55" r="18" fill="#48dbfb" opacity="0.8"/>
    <circle cx="30" cy="75" r="14" fill="#ff9ff3" opacity="0.6"/>
    <!-- Home button -->
    <circle cx="50" cy="130" r="4" fill="#666"/>
  </g>
  
  <!-- Text -->
  <text x="200" y="200" font-size="32" font-weight="bold" fill="white" text-anchor="middle">Smartphones</text>
  <text x="200" y="230" font-size="16" fill="rgba(255,255,255,0.8)" text-anchor="middle">Shop Now →</text>
</svg>